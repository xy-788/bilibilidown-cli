{
  "name": "bilidown-cli",
  "version": "0.1.0",
  "description": "Agent-friendly Bilibili media archival CLI with stable JSON output and Bilidown-style artifacts.",
  "type": "module",
  "bin": {
    "bdown": "./bin/bdown"
  },
  "scripts": {
    "bdown": "node ./src/cli/index.ts",
    "doctor": "node ./src/cli/index.ts doctor --json",
    "test": "node tests/unit/run.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "bilibili",
    "bilidown",
    "cli",
    "agent",
    "nfo"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
