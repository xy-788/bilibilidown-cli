{
  "name": "bilibilidown-cli",
  "version": "0.1.0",
  "description": "Agent-first Bilibili media download and archival CLI with built-in Skill support and stable JSON output.",
  "type": "module",
  "bin": {
    "bdown": "dist/bdown.js"
  },
  "scripts": {
    "bdown": "node ./src/cli/index.ts",
    "doctor": "node ./src/cli/index.ts doctor --json",
    "build": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --outfile=dist/bdown.js",
    "test": "node tests/unit/run.mjs && node tests/cli/run.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xy-788/bilibilidown-cli.git"
  },
  "bugs": {
    "url": "https://github.com/xy-788/bilibilidown-cli/issues"
  },
  "homepage": "https://github.com/xy-788/bilibilidown-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bilibili",
    "bilibili-download",
    "cli",
    "agent",
    "nfo"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
